FROM docker.io/debian:13.6

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3-pytest \
        python3-toml \
        python3-git \
        python3-yaml \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tests

ENTRYPOINT ["/bin/sh", "-c", "--"]
